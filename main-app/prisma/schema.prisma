// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             Int         @id @default(autoincrement())
  name           String    
  email          String      @unique
  password       String      // Never plain text
  resetToken     String?     // Store a hash of the token, not the token itself
  resetTokenExpiry DateTime?
  roleName       String      @default("customer")
  role           Role        @relation(fields:[roleName], references: [name])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  cartItems      CartItem[]
  orders         Order[]
}

model Product {
  id            Int          @id @default(autoincrement())
  name          String 
  description   String?       // filled by Groq when not provided
  price         Int           // in kobo: ₦1,500.00 = 150000
  imageUrl      String
  stock         Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  cartItems     CartItem[]
  orderItems    OrderItem[]
}

model CartItem {
  id         Int       @id @default(autoincrement())
  userId     Int
  productId  Int
  quantity   Int       @default(1)
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])  // same product twice = increment quantity, not a new row
}

model Order {
  id         Int        @id @default(autoincrement())
  userId     Int
  status     String     @default("pending") // pending | paid | delivered | cancelled
  total      Int        // in kobo: ₦1,500.00 = 150000
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user        User      @relation(fields: [userId], references: [id])
  items      OrderItem[]
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  productId   Int
  quantity    Int     @default(1)
  price       Int     // Price at the time of purchase, so later price changes don't affect old orders

  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])
}

model Role{
  name        String  @id
  user        User[]
}